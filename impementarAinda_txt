import pandas as pd

# 1. A Prancheta Vazia (Criamos uma lista vazia antes do loop)
carros_extraidos = []

lista_da_api = [{'nome': 'Civic', 'marca': 'Honda'}, {'nome': 'Corolla', 'marca': 'Toyota'}]

for carro in lista_da_api:
    # 2. Ao invés de só dar print, nós criamos um mini-dicionário do carro atual
    carro_atual = {
        'Modelo': carro['nome'],
        'Fabricante': carro['marca']
    }
    
    # 3. Adicionamos esse carro na nossa prancheta
    carros_extraidos.append(carro_atual)

# 4. Fora do loop, entregamos a prancheta cheia para o Pandas
df = pd.DataFrame(carros_extraidos)

# 5. Mandamos o Pandas salvar isso num arquivo CSV na pasta correta
# index=False evita que ele crie uma coluna inútil com números de 0 a 10
df.to_csv('../data/raw/carros_estoque.csv', index=False, sep=';', encoding='utf-8')

print("Arquivo salvo com sucesso!")